# 文本模型（负责生成 / 修复 Mermaid 代码）
TEXT_MODEL_NAME=your-text-model-name
TEXT_MODEL_API_KEY=sk-your-text-model-key
TEXT_MODEL_BASE_URL=https://api.example.com/v1

# 文本模型是否具备原生多模态能力（true/false）。
# 设为 true 后：生成可参考用户提供的图片（草图/现有流程图截图），
# 修改时会把当前渲染图一并发给模型参考。不具备视觉能力的模型请保持 false。
TEXT_MODEL_VISION=false

# 多模态模型（负责看图验证，必须支持图片输入）
VISION_MODEL_NAME=your-vision-model-name
VISION_MODEL_API_KEY=sk-your-vision-model-key
VISION_MODEL_BASE_URL=https://api.example.com/v1

# Agent 行为
MAX_ROUNDS=5
OUTPUT_FORMAT=png
# 画布背景色（mmdc -b），默认白色；不要用 transparent，会导致验证模型误判
RENDER_BACKGROUND=white
# PNG 渲染缩放倍数（mmdc -s），默认 2；大图表文字看不清时调高（如 3）
RENDER_SCALE=2
# PNG 视口宽度（mmdc -w），默认 4096。mermaid 会把图整体压缩进视口宽度
# （mmdc 默认 800，宽图文字会被压到看不清）；调大后按自然尺寸渲染，小图不受影响
RENDER_WIDTH=4096
# 视觉检视强度：full=完整检视（排版+内容语义，默认）；
# layout=仅基础图形检视（排版/遮挡/连线，不逐字核对内容）——
# 视觉模型文字识别能力弱、反复误判不通过时设为 layout
VERIFY_MODE=full
# mmdc 渲染用的 Chrome 可执行文件路径（可选）。
# 公司 Windows 环境 puppeteer 自带 Chromium 常被拦截/缺依赖导致 mmdc 报错，
# 设置后工具会自动生成 puppeteer-config.json 并以 -p 指定本机 Chrome。
# Windows 示例：CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# macOS 示例：CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CHROME_PATH=
# 作图风格模板目录（每个 .md 一个风格插件，主 Agent 自动发现）
# FLOWCHART_STYLE_DIR=styles
# 技能包目录（每个带 frontmatter 的 .md 一个提示词型技能，主 Agent 自动发现）
# FLOWCHART_SKILL_DIR=skills
