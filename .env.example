# 文本模型（负责生成 / 修复 Mermaid 代码）
TEXT_MODEL_NAME=your-text-model-name
TEXT_MODEL_API_KEY=sk-your-text-model-key
TEXT_MODEL_BASE_URL=https://api.example.com/v1

# 文本模型是否具备原生多模态能力（true/false）。
# 设为 true 后：生成可参考用户提供的图片（草图/现有流程图截图），
# 修改时会把当前渲染图一并发给模型参考。不具备视觉能力的模型请保持 false。
TEXT_MODEL_VISION=false

# 多模态模型（负责看图验证，必须支持图片输入）
VISION_MODEL_NAME=your-vision-model-name
VISION_MODEL_API_KEY=sk-your-vision-model-key
VISION_MODEL_BASE_URL=https://api.example.com/v1

# Agent 行为
MAX_ROUNDS=5
OUTPUT_FORMAT=png
# 画布背景色（mmdc -b），默认白色；不要用 transparent，会导致验证模型误判
RENDER_BACKGROUND=white
# 作图风格模板目录（每个 .md 一个风格插件，主 Agent 自动发现）
# FLOWCHART_STYLE_DIR=styles
